<% if(page.layout==='search'){ %><%- partial('_parts/search') %><% }else if(page.layout==='tags' || page.layout==='categories'){ %><%- partial('_parts/taxonomy') %><% }else if(page.layout==='about' || page.path==='about/index.html'){ %><%- partial('_parts/about') %><% }else{let contents=theme.toc.enable && page.toc!==false?toc(page.content,{class:'toc',list_number:false}):''; %><% if(contents || /<pre\b/i.test(page.content || '') || (theme.reading?.lightbox===true && page.lightbox!==false && /<img\b/i.test(page.content || ''))){ %><script src="<%= url_for('/js/reading.js') %>" defer></script><% } %><div class="reading <%= contents?'with-toc':'' %>"><main id="main"><header class="reading-heading"><a class="back" href="<%= url_for('/') %>"><%= milo_t('backHome') %></a><h1><%- milo_title(page.title) %></h1><div class="meta"><span><%= page.author || config.author %></span><span>·</span><time datetime="<%= date_xml(page.date) %>"><%= date(page.date,'YYYY-MM-DD') %></time><% if(page.categories){page.categories.each(c=>{ %><span>·</span><a href="<%= url_for(c.path) %>"><%= c.name %></a><% });} %><span>·</span><span><%= milo_t('readingTime',Math.max(1,Math.ceil(milo_words(page.content)/400))) %></span></div></header><% if(contents){ %><details class="mobile-toc"><summary><%= milo_t('toc') %></summary><nav aria-label="<%= milo_t('mobileToc') %>"><%- contents %></nav></details><% } %><% if(theme.reading?.progress!==false){ %><div class="reading-progress" hidden><label class="sr" for="reading-progress"><%= milo_t('progress') %></label><progress id="reading-progress" max="100" value="0"></progress><span aria-hidden="true">0%</span></div><% } %><article class="prose" lang="<%= milo_content_language() %>" id="post-content" data-lightbox="<%= theme.reading?.lightbox===true && page.lightbox!==false %>"><%- milo_reading_content(page.content) %></article><div class="article-footer"><p><%= milo_t('published',date(page.date,'YYYY-MM-DD')) %><% if(page.updated && date(page.updated,'YYYY-MM-DD')!==date(page.date,'YYYY-MM-DD')){ %><%= milo_t('updated',date(page.updated,'YYYY-MM-DD')) %><% } %></p><div class="tags"><% if(page.tags){page.tags.each(t=>{ %><a href="<%= url_for(t.path) %>"># <%= t.name %></a><% });} %></div></div><% if(is_post()){ %><nav class="post-nav" aria-label="<%= milo_t('postNavigation') %>"><% if(page.prev){ %><a class="post-prev" rel="prev" href="<%= url_for(page.prev.path) %>"><small><%= milo_t('prevPost') %></small><span><%= page.prev.title %></span><time datetime="<%= date_xml(page.prev.date) %>"><%= date(page.prev.date,'YYYY-MM-DD') %></time></a><% } %><% if(page.next){ %><a class="post-next" rel="next" href="<%= url_for(page.next.path) %>"><small><%= milo_t('nextPost') %></small><span><%= page.next.title %></span><time datetime="<%= date_xml(page.next.date) %>"><%= date(page.next.date,'YYYY-MM-DD') %></time></a><% } %></nav><% } %><% if(page.comments!==false && theme.comment.disqus.shortname){ %><section class="comments"><h2><%= milo_t('comments') %></h2><button class="load-comments" data-shortname="<%= theme.comment.disqus.shortname %>" data-url="<%= full_url_for(page.path.replace(/index\.html$/,'')) %>"><%= milo_t('loadComments') %></button><div id="disqus_thread"></div></section><% } %></main><% if(contents){ %><aside class="toc-sidebar"><h2><%= milo_t('toc') %></h2><nav aria-label="<%= milo_t('tocLabel') %>"><%- contents %></nav></aside><% } %></div><% } %>