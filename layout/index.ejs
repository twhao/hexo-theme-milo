<% const showIdentity=(!page.current || page.current===1) && !!(config.author || theme.img.avatar || theme.uiux.slogan?.length); %><div class="columns post-list<%= showIdentity?' has-mobile-identity':'' %>"><% if(showIdentity){ %><%- partial('_parts/identity') %><% } %><main id="main"><h1 class="sr"><%= config.title %> · <%= milo_t('postList') %><% if(page.current>1){ %> · <%= milo_t('pageNumber',page.current) %><% } %></h1><% let entryIndex=0; const coverSizes="(max-width: 800px) calc(100vw - 40px), (width < 1024px) 192.4px, calc((min(100vw, 1180px) - 368px) * .3)";if(!page.posts.length){ %><p class="muted"><%= milo_t('empty') %></p><% } page.posts.each(p=>{let text=milo_text(p.excerpt || p.content),words=milo_words(p.content); %><article class="entry"><div class="entry-copy<%= p.cover || p.thumbnail?' has-cover':'' %>"><div class="meta"><% p.categories.each(c=>{ %><a href="<%= url_for(c.path) %>"><%= c.name %></a><span>·</span><% }); %><time datetime="<%= date_xml(p.date) %>"><%= date(p.date,'YYYY-MM-DD') %></time><span>·</span><span><%= words>=1000?milo_t('wordCompact',(words/1000).toFixed(1)):milo_t('wordShort',words) %></span></div><h2><a href="<%= url_for(p.path) %>"><%- milo_title(p.title) %></a></h2><% const cover=p.cover || p.thumbnail; if(cover){ const sources=milo_webp(cover), lazy=entryIndex>=2; %><a class="cover<%= p.cover_fit==='contain'?' cover-contain':'' %>" href="<%= url_for(p.path) %>" tabindex="-1" aria-hidden="true"><% if(sources){ %><picture><source type="image/webp" srcset="<%= sources %>" sizes="<%= (lazy?'auto, ':'')+coverSizes %>"><% } %><img src="<%= url_for(cover) %>" alt="" loading="<%= lazy?'lazy':'eager' %>"<% if(entryIndex===0){ %> fetchpriority="high"<% } %> decoding="async" width="320" height="200"><% if(sources){ %></picture><% } %></a><% } %><p><%= text.slice(0,210) %><%= text.length>210?'…':'' %></p></div></article><% entryIndex++; }); %><%- partial('_parts/pager') %></main><%- partial('_parts/sidebar') %></div>