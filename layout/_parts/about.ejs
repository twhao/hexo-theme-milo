<main id="main" class="about"><header class="about-heading"><% if(theme.img.avatar){ %><img src="<%= url_for(theme.img.avatar) %>" alt="<%= milo_t('authorAvatar',config.author || config.title) %>" width="96" height="96"><% } %><p class="eyebrow"><%= milo_t('aboutMe') %></p><h1><%= config.author || config.title %></h1><p class="about-slogan"><%= Array.isArray(theme.uiux.slogan)?theme.uiux.slogan.join(' '):theme.uiux.slogan %></p><%- partial('_parts/social') %></header><section class="about-content prose" lang="<%= milo_content_language() %>"><%- page.content %></section></main>