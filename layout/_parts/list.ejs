<div class="columns"><main id="main"><header class="page-heading"><p><%= milo_t(page.tag?'tagPosts':page.category?'categoryPosts':'archiveEyebrow') %></p><h1><%= page.tag?'# '+page.tag:page.category || (page.year?milo_t('yearArchive',page.year):milo_t('archives')) %></h1><p><%= milo_t('postCount',milo_post_count(page,site)) %></p></header><% let year='';page.posts.sort('date',-1).each(p=>{let y=date(p.date,'YYYY');if(y!==year){year=y; %><h2 class="year"><%= y %></h2><% } %><a class="archive-row" href="<%= url_for(p.path) %>"><time><%= date(p.date,'MM-DD') %></time><span><%= p.title %></span></a><% }); %><%- partial('_parts/pager') %></main><%- partial('_parts/sidebar') %></div>