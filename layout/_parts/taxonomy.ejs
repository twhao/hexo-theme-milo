<% let categories=page.layout==='categories',items=categories?site.categories:site.tags; %><div class="columns"><main id="main"><header class="page-heading"><p><%= milo_t('taxonomyEyebrow') %></p><h1><%= milo_t(categories?'categories':'tags') %></h1><p><%= milo_t(categories?'categoryCount':'tagCount',items.length) %></p></header><div class="chips"><% items.sort('name',1).each(item=>{ %><a href="<%= url_for(item.path) %>"><span><%= categories?'':'# ' %><%= item.name %></span><small><%= milo_t('chipCount',item.length) %></small></a><% }); %></div><% if(!items.length){ %><p class="muted"><%= milo_t('empty') %></p><% } %></main><%- partial('_parts/sidebar') %></div>