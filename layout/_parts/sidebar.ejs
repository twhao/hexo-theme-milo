<aside class="sidebar" aria-label="<%= milo_t('sidebar') %>"><section class="profile"><div class="profile-heading"><% if(theme.img.avatar){ %><img src="<%= url_for(theme.img.avatar) %>" width="56" height="56" alt="<%= milo_t('avatar') %>"><% } %><strong><%= config.author || config.title %></strong></div><p class="slogan"><%= Array.isArray(theme.uiux.slogan)?theme.uiux.slogan.join(' '):theme.uiux.slogan %></p><%- partial('_parts/social') %><div class="stats"><a href="<%= url_for('/archives/') %>"><strong><%= site.posts.length %></strong><span><%= milo_t('posts') %></span></a><a href="<%= url_for('/categories/') %>"><strong><%= site.categories.length %></strong><span><%= milo_t('categories') %></span></a><a href="<%= url_for('/tags/') %>"><strong><%= site.tags.length %></strong><span><%= milo_t('tags') %></span></a><% let total=0;site.posts.each(p=>total+=milo_words(p.content)); %><div title="<%= milo_t('wordStats') %>"><strong><%= total>=10000 && milo_locale()!=='en'?(total/10000).toFixed(1):total.toLocaleString(milo_locale()) %></strong><span><%= milo_t(total>=10000 && milo_locale()!=='en'?'tenThousandWords':'words') %></span></div></div><a class="primary about-link" href="<%= url_for('/about/') %>"><%= milo_t('aboutMe') %></a></section><div class="sidebar-sticky<%= theme.sidebar?.sticky===false?'':' is-sticky' %>"><section class="side-section"><h2><%= milo_t('recent') %></h2><% site.posts.sort('date',-1).limit(4).each(p=>{ %><a class="recent" href="<%= url_for(p.path) %>"><span><%= p.title %></span><time><%= date(p.date,'YYYY-MM-DD') %></time></a><% }); %></section><% if(site.categories.length){ %><section class="side-section"><h2><%= milo_t('categories') %></h2><% site.categories.sort('name',1).each(c=>{ %><a class="category" href="<%= url_for(c.path) %>"><span><%= c.name %></span><span><%= c.length %></span></a><% }); %></section><% } %></div></aside>