<% const links=milo_social(); if(links.length){
  // The GitHub outline is adapted from Lucide / Feather (source/images/lucide-LICENSE.txt).
  const icons={
    github:'M9 19c-4 1.5-4-2-6-2.5m12 5v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.8A5.3 5.3 0 0 0 19 5.4 5 5 0 0 0 18.9 2S17.7 1.7 15 3.5a13.4 13.4 0 0 0-7 0C5.3 1.7 4.1 2 4.1 2A5 5 0 0 0 4 5.4a5.3 5.3 0 0 0-1.3 3.7c0 5.3 3.2 6.5 6.2 6.8A3.4 3.4 0 0 0 8 18.5V22',
    email:'M3 5h18v14H3z M3 6l9 7 9-7',
    rss:'M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 19h.01',
    website:'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z',
    link:'M10 13a4 4 0 0 0 6 0l4-4a4 4 0 0 0-6-6l-2 2m2 6a4 4 0 0 0-6 0l-4 4a4 4 0 0 0 6 6l2-2'
  };
%><nav class="profile-social" aria-label="<%= milo_t('social') %>">
  <% for(const {key,href,label} of links){ %>
    <a href="<%= href %>" aria-label="<%= label %>" rel="me">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="<%= Object.hasOwn(icons,key)?icons[key]:icons.link %>"/></svg>
    </a>
  <% } %>
</nav><% } %>
